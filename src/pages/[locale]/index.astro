---
import HomePage from '~/components/pages/HomePage.astro'
import { getHomepageContent } from '~/data/homepage'
import { defaultLocale, supportedLocales, type Locale } from '~/data/site'
import Layout from '~/layouts/Layout.astro'
import { getHomepageStructuredData } from '~/lib/seo'

export function getStaticPaths() {
  return supportedLocales
    .filter(locale => locale !== defaultLocale)
    .map(locale => ({ params: { locale } }))
}

const content = getHomepageContent(Astro.params.locale as Locale)
const structuredData = getHomepageStructuredData(content)
---

<Layout
  lang={content.locale}
  title={content.metaTitle}
  description={content.metaDescription}
  structuredData={structuredData}
>
  <HomePage content={content} pathname={Astro.url.pathname} />
</Layout>
