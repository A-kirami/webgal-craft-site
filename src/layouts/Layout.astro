---
import '~/styles/global.css'
import '~/styles/homepage.css'
import '~/styles/islands.css'
import { defaultLocale, getCanonicalUrl, getLocaleUrl, siteMetadata, supportedLocales } from '~/data/site'

interface Props {
  title: string
  description: string
  lang: string
}

const { title, description, lang } = Astro.props
const canonicalUrl = getCanonicalUrl(Astro.url.pathname)
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      {
        const THEME_KEY = 'webgal-craft-theme'

        const canPrepareMotion = (
          'IntersectionObserver' in window
          && 'animate' in Element.prototype
          && window.matchMedia?.('(prefers-reduced-motion: reduce)').matches !== true
        )

        if (canPrepareMotion) {
          document.documentElement.classList.add('motion-ready')
        }

        const resolveTheme = () => {
          const storedTheme = (() => {
            try {
              return window.localStorage.getItem(THEME_KEY)
            } catch {
              return null
            }
          })()
          return storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'dark'
        }

        document.documentElement.dataset.theme = resolveTheme()
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content={siteMetadata.themeColors.dark}
      data-light={siteMetadata.themeColors.light}
      data-dark={siteMetadata.themeColors.dark}
    />
    <link rel="icon" type="image/svg+xml" href={siteMetadata.faviconPath} />
    <link rel="canonical" href={canonicalUrl} />
    {supportedLocales.map(locale => (
      <link rel="alternate" hreflang={locale} href={getLocaleUrl(locale)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getLocaleUrl(defaultLocale)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMetadata.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
    <script>
      import { initMotion } from '~/lib/motion'

      initMotion()
    </script>
  </body>
</html>
